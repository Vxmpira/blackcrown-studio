{
  "name": "blackcrown-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BlackCrown admin: preview and one-click cloud-export branded ads",
  "scripts": {
    "dev": "vite",
    "server": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "studio": "remotion studio src/remotion/index.ts",
    "deploy:fn": "remotion lambda functions deploy",
    "deploy:site": "remotion lambda sites create src/remotion/index.ts --site-name=blackcrown-ads"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/lambda": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "cors": "^2.8.5",
    "ffmpeg-static": "^5.2.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "three": "^0.186.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
