{
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/lambda"
	},
	"name": "@remotion/lambda",
	"version": "4.0.476",
	"description": "Render Remotion videos on AWS Lambda",
	"main": "dist/index.js",
	"scripts": {
		"formatting": "oxfmt src --check",
		"format": "oxfmt src",
		"lint": "eslint src",
		"testlambda": "exit 0",
		"test": "bun test src/test/unit",
		"make": "tsgo -d && bun --env-file=../.env.bundle bundle.ts",
		"makeruntime": "bun build.ts",
		"prepublishOnly": "bun build.ts && bun ensure-version-match.js"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"license": "SEE LICENSE IN LICENSE.md",
	"dependencies": {
		"@aws-sdk/s3-request-presigner": "3.986.0",
		"@aws-sdk/middleware-flexible-checksums": "3.972.5",
		"@aws-sdk/client-lambda": "3.986.0",
		"@aws-sdk/client-s3": "3.986.0",
		"@aws-sdk/client-sts": "3.986.0",
		"@aws-sdk/client-iam": "3.986.0",
		"@aws-sdk/client-cloudwatch-logs": "3.986.0",
		"@aws-sdk/client-service-quotas": "3.986.0",
		"@aws-sdk/lib-storage": "3.986.0",
		"@remotion/bundler": "4.0.476",
		"@remotion/cli": "4.0.476",
		"@remotion/lambda-client": "4.0.476",
		"@remotion/renderer": "4.0.476",
		"@remotion/serverless": "4.0.476",
		"@remotion/streaming": "4.0.476",
		"@smithy/abort-controller": "4.0.1",
		"remotion": "4.0.476",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@remotion/bundler": "4.0.476",
		"@types/express": "5.0.1",
		"express": "4.21.0",
		"@remotion/compositor-linux-arm64-gnu": "4.0.476",
		"@remotion/eslint-config-internal": "4.0.476",
		"mime-types": "2.1.34",
		"@types/mime-types": "2.1.1",
		"@types/minimist": "1.2.2",
		"eslint": "9.19.0",
		"next": "16.2.6",
		"pureimage": "0.4.13",
		"@types/node": "20.12.14",
		"@typescript/native-preview": "7.0.0-dev.20260217.1"
	},
	"peerDependencies": {
		"@remotion/bundler": "4.0.476"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"require": "./dist/client.js",
			"module": "./dist/esm/client.mjs",
			"import": "./dist/esm/client.mjs"
		},
		"./policies": {
			"types": "./dist/policies.d.ts",
			"require": "./dist/policies.js",
			"module": "./dist/esm/policies.mjs",
			"import": "./dist/esm/policies.mjs"
		}
	},
	"typesVersions": {
		">=1.0": {
			"client": [
				"./dist/client.d.ts"
			],
			"policies": [
				"./dist/policies.d.ts"
			]
		}
	},
	"homepage": "https://www.remotion.dev/docs/lambda"
}
