{
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/lambda-client"
	},
	"name": "@remotion/lambda-client",
	"version": "4.0.476",
	"main": "dist/cjs/index.js",
	"scripts": {
		"formatting": "oxfmt src --check",
		"format": "oxfmt src",
		"test": "bun test src",
		"lint": "eslint src",
		"make": "tsgo -d && bun --env-file=../.env.bundle bundle.ts"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"license": "UNLICENSED",
	"dependencies": {},
	"devDependencies": {
		"@aws-sdk/client-cloudwatch-logs": "3.986.0",
		"@aws-sdk/client-iam": "3.986.0",
		"@aws-sdk/client-lambda": "3.986.0",
		"@aws-sdk/s3-request-presigner": "3.986.0",
		"@aws-sdk/client-s3": "3.986.0",
		"@aws-sdk/client-service-quotas": "3.986.0",
		"@aws-sdk/client-sts": "3.986.0",
		"@aws-sdk/lib-storage": "3.986.0",
		"mime-types": "2.1.34",
		"@aws-sdk/credential-provider-ini": "3.972.5",
		"@remotion/serverless-client": "4.0.476",
		"@types/express": "5.0.1",
		"express": "4.21.0",
		"@remotion/eslint-config-internal": "4.0.476",
		"eslint": "9.19.0",
		"next": "16.2.6",
		"@types/mime-types": "2.1.1",
		"@typescript/native-preview": "7.0.0-dev.20260217.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/cjs/index.d.ts",
			"require": "./dist/cjs/index.js",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		},
		"./constants": {
			"types": "./dist/cjs/constants.d.ts",
			"require": "./dist/cjs/constants.js",
			"module": "./dist/esm/constants.mjs",
			"import": "./dist/esm/constants.mjs"
		},
		"./regions": {
			"types": "./dist/cjs/regions.d.ts",
			"require": "./dist/cjs/regions.js",
			"module": "./dist/esm/regions.mjs",
			"import": "./dist/esm/regions.mjs"
		}
	},
	"typesVersions": {
		">=1.0": {
			"constants": [
				"./dist/cjs/constants.d.ts"
			],
			"regions": [
				"./dist/cjs/regions.d.ts"
			]
		}
	}
}
